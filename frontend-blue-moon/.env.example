VITE_API_URL=http://localhost:8000
# Slug del salón en la BD (frontend dedicado a Blue Moon). Debe coincidir EXACTO
# con el slug guardado en la tabla salones, no con el subdominio.
VITE_SALON_SLUG=blue-moon

# Meta Pixel (Facebook/Instagram Ads). Dejar VACÍO en local y en staging: el
# pixel sólo se inicializa si esta variable tiene valor, así los turnos de
# prueba no ensucian los datos de la campaña. En producción lo setea el build
# arg de docker-compose.yml (pixel de Blue Moon: 1812436623450422).
VITE_META_PIXEL_ID=
